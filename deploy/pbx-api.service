# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=pbx-api - business REST API and MQTT bridge for FreePBX/Asterisk
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=pbx-api
Group=pbx-api
ExecStart=/opt/pbx-api/venv/bin/pbx-api --config /etc/pbx-api/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# Hardening: the service only reads its config and talks to local sockets/TCP
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
